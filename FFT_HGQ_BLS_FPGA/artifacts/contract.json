{
  "harmonics": [
    1,
    3,
    5,
    7
  ],
  "input": {
    "dtype": "float32",
    "name": "waveform",
    "normalization": "x / max(abs(x))",
    "shape": [
      "batch",
      80,
      1
    ],
    "window_peak_is_external_side_channel": true
  },
  "legacy_control_output": [
    "A1",
    "A3",
    "A5",
    "A7",
    "delta3",
    "delta5",
    "delta7"
  ],
  "model": "residual_bls",
  "order_scales": [
    1.0,
    0.25,
    0.2,
    0.15
  ],
  "output": {
    "dtype": "float32",
    "encoding": "A_h/(window_peak*order_scale_h) * [cos(psi_end_h), sin(psi_end_h)]",
    "name": "3505",
    "order": [
      "c1",
      "s1",
      "c3",
      "s3",
      "c5",
      "s5",
      "c7",
      "s7"
    ],
    "shape": [
      "batch",
      8
    ]
  },
  "physical_extended_output": [
    "A1",
    "A3",
    "A5",
    "A7",
    "psi1",
    "psi3",
    "psi5",
    "psi7"
  ],
  "relative_phase": "wrap(psi_end_h - h*theta_pll_end), or use predicted psi1 as fallback reference",
  "sampling_rate_hz": 4000.0,
  "waveform_convention": "A_h * sin(2*pi*h*f0*(t-t_end) + psi_end_h)",
  "window_duration_ms": 20.0,
  "window_size": 80
}
